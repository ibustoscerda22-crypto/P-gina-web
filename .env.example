# Copia este archivo como .env y completa los valores.
# Credenciales en: https://www.mercadopago.cl/developers/panel/app
# Usa primero las credenciales de PRUEBA (TEST-...) y luego las de PRODUCCIÓN (APP_USR-...).
MP_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MP_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Clave secreta de webhooks (Tus integraciones > Webhooks > Clave secreta).
MP_WEBHOOK_SECRET=

# URL pública donde está publicada la tienda (sin "/" al final).
# En local puedes usar un túnel (ngrok, cloudflared) para que MercadoPago pueda notificar pagos.
BASE_URL=http://localhost:3000

PORT=3000

# Costo de despacho fijo en CLP y monto desde el cual el envío es gratis.
SHIPPING_COST=3990
FREE_SHIPPING_FROM=50000
