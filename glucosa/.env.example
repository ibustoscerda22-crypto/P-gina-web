# Cuenta de LibreLinkUp que SIGUE tu sensor (no la de la app FreeStyle Libre)
LIBRE_EMAIL=tu-correo@ejemplo.com
LIBRE_PASSWORD=tu-contraseña

# Opcional: región de la cuenta (eu, us, la, ...). Si no la pones se detecta sola.
LIBRE_REGION=
# Si LibreLinkUp empieza a rechazar la conexión, sube este número a la versión actual de la app
LIBRE_VERSION=4.16.0

# Panel
PORT=3100
POLL_SECONDS=60
# Contraseña para abrir el panel (muy recomendable si lo publicas en internet)
PANEL_PASSWORD=
TZ_PANEL=America/Santiago

# Rangos en mg/dL (consenso internacional por defecto; ajústalos con tu médico)
GLUCOSA_MUY_BAJO=54
GLUCOSA_BAJO=70
GLUCOSA_ALTO=180
GLUCOSA_MUY_ALTO=250

# Avisos al celular con la app ntfy (gratis). Inventa un tema largo y difícil de adivinar,
# por ejemplo glucosa-ignacio-8f3k2q9x, y suscríbete a ese mismo tema en la app ntfy.
NTFY_TEMA=
ALERTA_BAJO=50
ALERTA_ALTO=250
# Cada cuántos minutos repetir el aviso mientras sigas bajo / alto
ALERTA_REPETIR_BAJO_MIN=10
ALERTA_REPETIR_ALTO_MIN=30
# Avisar si no llegan lecturas en estos minutos (0 = no avisar)
ALERTA_SIN_DATOS_MIN=30

# 1 = datos falsos para probar sin cuenta
LIBRE_MOCK=0
